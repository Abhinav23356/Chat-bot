# Comma-separated provider keys, in fallback order. Use at least two keys.
LLM_API_KEYS=replace_with_provider_key_1,replace_with_provider_key_2
# Gemini 2.0 Flash has been retired; use a currently available model.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Persists across backend container restarts through the named Docker volume.
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# Local backend port; Railway supplies its own PORT at deploy time.
PORT=8000
# Used by the frontend build. Set to your public backend URL for a deployment.
VITE_API_BASE_URL=http://localhost:8000
